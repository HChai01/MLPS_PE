process {
    cpus = { Math.max(1, (params.threads ?: 1) as Integer) }

    withName:CHECK_HUMAN_REFERENCE {
        cpus = 1
    }

    withName:FORMAT_TARGET_REFERENCE {
        cpus = 1
    }

    withName:MERGE_SUMMARY_TABLE {
        cpus = 1
    }

    withName:MERGE_FASTA_COLLECTION {
        cpus = 1
    }
}

cleanup = false

