params {
    inputcsv = "${projectDir}/sample_list.csv"
    outdir = "${projectDir}/results/test"
    human_db = "${projectDir}/reference/BOWTIE2/human_pilot"
    target_reference = "${projectDir}/reference/ref.HBV.04092023.fasta"
    dedup = 'yes'
    target_genome_type = 'linear'
    bq_thr = 13
    depth_thr = 5
    qual_thr = 30
    remove_human = 'yes'
    threads = 1
}

process {
    withLabel:light {
        cpus = 1
    }
}
