manifest {
    name = 'MLPS_SE'
    author = 'Dr. Haiting Chai'
    homePage = 'https://github.com/example/MLPS_SE'
    description = 'First-pass DSL2 Nextflow pipeline for the MLPS single-end workflow.'
    version = '0.1.0'
    nextflowVersion = '>=23.10.0'
}

params {
    input              = null
    outdir             = 'results'
    project_name       = 'project'
    human_db           = null
    target_reference   = null
    dedup              = 'yes'
    target_genome_type = 'linear'
    bq_thr             = 13
    depth_thr          = 5
    qual_thr           = 30
    cleantmpdata       = 'yes'
    cleantmpdatasize   = '1MB'
    remove_human       = 'yes'
    threads            = 1
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    stageInMode = 'rellink'
    errorStrategy = 'terminate'
    maxRetries = 1
    cache = 'lenient'
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}

conda {
    enabled = true
    useMamba = false
}

includeConfig 'conf/base.config'

profiles {
    local {
        includeConfig 'conf/local.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
    ci {
        includeConfig 'conf/ci.config'
    }
}
